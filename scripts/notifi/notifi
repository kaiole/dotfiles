#!/usr/bin/env python3
"""Desktop notifications for coding agents in tmux, on Hyprland with dunst.

    notifi show [--event EVENT] [--app NAME] [--force] [-v]
    notifi dismiss [--app NAME | --focused]
    notifi pending [--waybar]
    notifi next
    notifi status

`show` notifies for the agent in this tmux pane and returns at once; a
detached waiter stays until the notification closes and runs its Focus
action. An agent whose notification is closed without that stays pending,
and one that was gone to stays seen: `pending` lists both and `next` focuses
the pending ones, then goes round the seen ones. `dismiss` forgets the agent
from any later process. See README.md.
"""

import argparse
import fcntl
import functools
import json
import os
import re
import select
import signal
import subprocess
import sys
import time
from contextlib import contextmanager, suppress
from typing import Any, NamedTuple


class Event(NamedTuple):
    body: str
    urgency: str
    expire_ms: int  # 0 keeps the notification until it is dismissed
    focus_aware: bool  # skip while the agent's tmux window is on screen


EVENTS = {
    "finished": Event("Task Finished", "normal", 0, True),
    "attention": Event("Needs Input", "normal", 0, True),
    "error": Event("Task Failed", "critical", 0, False),
    "aborted": Event("Task Aborted", "critical", 5000, False),
}

SSH_VARIABLES = ("SSH_CONNECTION", "SSH_TTY", "SSH_CLIENT")
STATE_DIR = os.path.join(
    os.environ.get("XDG_RUNTIME_DIR") or f"/tmp/notifi-{os.getuid()}", "notifi"
)
# custom/agents in waybar/config.jsonc counts the pending agents again on
# SIGRTMIN+8.
WAYBAR_SIGNAL = 8


def run(*command: str) -> str | None:
    """Runs a command and returns its stdout, or None if it fails."""
    try:
        done = subprocess.run(
            command,
            stdin=subprocess.DEVNULL,
            capture_output=True,
            text=True,
            timeout=3,
        )
    except (OSError, subprocess.TimeoutExpired):
        return None
    return done.stdout if done.returncode == 0 else None


def parse_json(text: str | None) -> Any:
    try:
        return None if text is None else json.loads(text)
    except ValueError:
        return None


# ---------------------------------------------------------------------------
# tmux. $TMUX is "<socket>,<server pid>,<session>"; tmux itself cuts it at the
# first comma, so pass the socket explicitly. -N keeps a command from starting
# a new server if that one is gone.


def tmux_socket() -> str | None:
    return ",".join(os.environ.get("TMUX", "").split(",")[:-2]) or None


def tmux(socket: str | None, *args: str) -> str | None:
    return run("tmux", "-N", "-S", socket, *args) if socket else None


class Pane(NamedTuple):
    id: str
    socket: str
    server: str  # the tmux server's pid; pane ids start over when it does
    session_id: str
    window_id: str
    title: str


def find_pane(socket: str | None, pane_id: str | None) -> Pane | None:
    """A tmux pane as it is now, or None if it is gone.

    Looked up on each use because panes move. tmux answers for a dead pane
    too, with an empty session and window.
    """
    if not socket or not pane_id:
        return None
    out = tmux(
        socket,
        "display-message",
        "-p",
        "-t",
        pane_id,
        "#{pid}\t#{session_id}\t#{window_id}\t#S:#{window_index}",
    )
    fields = (out or "").rstrip("\n").split("\t")
    if len(fields) != 4 or not all(fields[:3]):
        return None
    return Pane(pane_id, socket, *fields)


def own_pane() -> Pane | None:
    """The tmux pane of the agent running this command."""
    return find_pane(tmux_socket(), os.environ.get("TMUX_PANE"))


def desktop_allowed() -> bool:
    """Whether this agent may notify the local desktop.

    A tmux server can be told with `set-option -s @notifi-desktop on|off`;
    by default (`auto`) it may unless it was started over SSH. The server's
    global environment is checked rather than the agent's, which can keep
    stale SSH variables after a reattach.
    """
    if not os.environ.get("TMUX"):
        return not any(os.environ.get(name) for name in SSH_VARIABLES)

    socket = tmux_socket()
    mode = tmux(socket, "show-options", "-sqv", "@notifi-desktop")
    mode = None if mode is None else mode.strip().lower()
    if mode == "on":
        return True
    if mode not in ("", "auto"):
        return False  # off, unreachable, or invalid
    environment = tmux(socket, "show-environment", "-g")
    return environment is not None and not any(
        re.search(f"^{name}=.", environment, re.M) for name in SSH_VARIABLES
    )


class Client(NamedTuple):
    pid: int
    tty: str
    session_id: str
    window_id: str
    activity: int
    windows: list[dict[str, Any]]  # the Hyprland windows it may be in


def tmux_clients(socket: str) -> list[Client]:
    out = tmux(
        socket,
        "list-clients",
        "-F",
        "#{client_pid}\t#{client_tty}\t#{session_id}\t#{window_id}"
        "\t#{client_activity}",
    )
    clients = []
    for line in filter(None, (out or "").split("\n")):
        pid, tty, session_id, window_id, activity = line.split("\t")
        clients.append(
            Client(int(pid), tty, session_id, window_id, int(activity), [])
        )
    return clients


# ---------------------------------------------------------------------------
# Hyprland


class Hyprland(NamedTuple):
    signature: str
    wl_socket: str
    windows: list[dict[str, Any]]
    visible_workspaces: set[int]

    def dispatch(self, lua: str) -> None:
        run("hyprctl", "--instance", self.signature, "dispatch", lua)


def hyprland() -> Hyprland | None:
    """Snapshot of the running Hyprland.

    The agent inherits HYPRLAND_INSTANCE_SIGNATURE from tmux, and a tmux
    server outlives Hyprland restarts, so that signature is used only while
    its instance is still running; otherwise use the newest.
    """
    instances = parse_json(run("hyprctl", "instances", "-j"))
    if not isinstance(instances, list) or not instances:
        return None
    inherited = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
    instance = next(
        (i for i in instances if i.get("instance") == inherited), None
    ) or max(instances, key=lambda i: i.get("time", 0))
    signature = str(instance.get("instance", ""))

    windows = parse_json(
        run("hyprctl", "--instance", signature, "clients", "-j")
    )
    monitors = parse_json(
        run("hyprctl", "--instance", signature, "monitors", "-j")
    )
    if not isinstance(windows, list) or not isinstance(monitors, list):
        return None

    visible = set()
    for monitor in monitors:
        for key in ("activeWorkspace", "specialWorkspace"):
            workspace = (monitor.get(key) or {}).get("id")
            if isinstance(workspace, int) and workspace != 0:
                visible.add(workspace)
    return Hyprland(
        signature, str(instance.get("wl_socket", "")), windows, visible
    )


def ancestors(pid: int) -> set[int]:
    pids: set[int] = set()
    while pid > 1 and pid not in pids:
        pids.add(pid)
        try:
            with open(f"/proc/{pid}/status") as status:
                parent = re.search(r"^PPid:\s+(\d+)$", status.read(), re.M)
        except OSError:
            break
        pid = int(parent.group(1)) if parent else 0
    return pids


def attached_clients(hypr: Hyprland, socket: str) -> list[Client]:
    """tmux clients running inside a Hyprland window, by process ancestry.

    A single-instance Ghostty serves every window from one process, so a
    client can match several windows.
    """
    attached = []
    for client in tmux_clients(socket):
        tree = ancestors(client.pid)
        windows = [
            w
            for w in hypr.windows
            if w.get("mapped") and not w.get("hidden") and w.get("pid") in tree
        ]
        if windows:
            attached.append(client._replace(windows=windows))
    return attached


def pane_visible(pane: Pane) -> bool:
    """Whether a tmux client shows the pane's window in a window on screen."""
    hypr = hyprland()
    if not hypr:
        return False
    return any(
        client.session_id == pane.session_id
        and client.window_id == pane.window_id
        and any(
            (w.get("workspace") or {}).get("id") in hypr.visible_workspaces
            for w in client.windows
        )
        for client in attached_clients(hypr, pane.socket)
    )


def history_rank(window: dict[str, Any]) -> float:
    rank = window.get("focusHistoryID", -1)
    return rank if rank >= 0 else float("inf")


def focus_pane(pane: Pane) -> bool:
    """Brings a pane to the front; False if no Hyprland is running.

    Selects it in tmux, focuses the Hyprland window of the best attached
    client, and switches that client to the pane's session. Opens a new
    Ghostty only when no attached client lives in a Hyprland window. All of
    it is worked out now, not when the notification was sent.
    """
    hypr = hyprland()
    if not hypr:
        return False

    tmux(pane.socket, "select-window", "-t", pane.id)
    tmux(pane.socket, "select-pane", "-t", pane.id)

    # Prefer a client already on the pane's session, then the most recently
    # used one.
    clients = sorted(
        attached_clients(hypr, pane.socket),
        key=lambda c: (c.session_id != pane.session_id, -c.activity),
    )
    if not clients:
        open_terminal(hypr, pane)
        return True
    client = clients[0]

    # With several windows in one process, assume the client is in the one
    # focused most recently.
    address = str(min(client.windows, key=history_rank).get("address", ""))
    if re.fullmatch(r"0x[0-9a-fA-F]+", address):
        hypr.dispatch(f'hl.dsp.focus({{ window = "address:{address}" }})')
    if client.session_id != pane.session_id:
        tmux(
            pane.socket,
            "switch-client",
            "-c",
            client.tty,
            "-t",
            pane.session_id,
        )
    return True


def open_terminal(hypr: Hyprland, pane: Pane) -> None:
    env = {
        **os.environ,
        "HYPRLAND_INSTANCE_SIGNATURE": hypr.signature,
        "WAYLAND_DISPLAY": hypr.wl_socket,
    }
    env.pop("TMUX", None)
    env.pop("TMUX_PANE", None)
    attach = [
        "tmux",
        "-S",
        pane.socket,
        "attach-session",
        "-t",
        pane.session_id,
    ]
    with suppress(OSError):
        subprocess.Popen(
            ["ghostty", "-e", *attach],
            env=env,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )


# ---------------------------------------------------------------------------
# Notifications. Each agent has at most one record: a state file that says
# what it is waiting with and, while its notification is up, how to close it.
# Without the notification the agent is pending, or seen once the user went
# to it.


def gdbus(dest: str, path: str, method: str, *args: str) -> str | None:
    return run(
        "gdbus",
        "call",
        "--session",
        "--dest",
        dest,
        "--object-path",
        path,
        "--method",
        method,
        *args,
    )


@functools.cache
def daemon_owner() -> str | None:
    """The bus name of the running notification daemon."""
    owner = gdbus(
        "org.freedesktop.DBus",
        "/org/freedesktop/DBus",
        "org.freedesktop.DBus.GetNameOwner",
        "org.freedesktop.Notifications",
    )
    return owner.strip() if owner else None


def refresh_bar() -> None:
    """Has waybar count the pending agents again."""
    run("pkill", f"-RTMIN+{WAYBAR_SIGNAL}", "-x", "waybar")


def state_path(app: str) -> str:
    """One record per tmux pane, or per app outside tmux."""
    socket, pane_id = tmux_socket(), os.environ.get("TMUX_PANE")
    key = f"{socket}{pane_id}" if socket and pane_id else app
    return os.path.join(
        STATE_DIR, key.replace("%", "%25").replace("/", "%2F") + ".json"
    )


def record_paths() -> list[str]:
    try:
        names = os.listdir(STATE_DIR)
    except OSError:
        return []
    return [
        os.path.join(STATE_DIR, name)
        for name in names
        if name.endswith(".json")
    ]


def read_state(path: str) -> dict[str, Any] | None:
    try:
        with open(path) as file:
            state = json.load(file)
    except (OSError, ValueError):
        return None
    return state if isinstance(state, dict) else None


def write_state(path: str, state: dict[str, Any]) -> None:
    with open(path, "w") as file:
        json.dump(state, file)


@contextmanager
def locked():
    """Serializes reads and changes of the state files."""
    os.makedirs(STATE_DIR, mode=0o700, exist_ok=True)
    lock = os.open(
        os.path.join(STATE_DIR, "lock"), os.O_CREAT | os.O_RDWR, 0o600
    )
    try:
        fcntl.flock(lock, fcntl.LOCK_EX)
        yield
    finally:
        os.close(lock)


def start_time(pid: int) -> str | None:
    """A process's start time, which tells it from a later reuse of its pid."""
    try:
        with open(f"/proc/{pid}/stat") as stat:
            return stat.read().rsplit(")", 1)[1].split()[19]
    except (OSError, IndexError):
        return None


def toast_sender(state: dict[str, Any]) -> int | None:
    """The live notify-send of the record's notification, if it has one.

    notify-send exits with its notification, so without it the notification
    is gone. It lingers if the daemon died (dunst exits with Hyprland).
    """
    toast = state.get("toast")
    if not isinstance(toast, dict):
        return None
    pid, started = toast.get("pid"), toast.get("started")
    if not isinstance(pid, int) or not started or start_time(pid) != started:
        return None
    return pid


def toast_up(state: dict[str, Any]) -> bool:
    """Whether the record's notification is still on the desktop."""
    if toast_sender(state) is None:
        return False
    # A daemon started since then never had it.
    return state["toast"].get("owner") in (None, daemon_owner())


def close(path: str) -> None:
    """Forgets the record at `path`, closing its notification if that is up.

    Call it locked.
    """
    state = read_state(path)
    with suppress(OSError):
        os.unlink(path)
    if not state:
        return
    refresh_bar()
    pid = toast_sender(state)
    if pid is None:
        return
    # Stop a lingering notify-send too.
    with suppress(OSError):
        os.kill(pid, signal.SIGTERM)
    # Ids restart with the daemon, so only close one that the running daemon
    # issued; otherwise this could close someone else's.
    owner = state["toast"].get("owner")
    if owner and owner == daemon_owner():
        gdbus(
            "org.freedesktop.Notifications",
            "/org/freedesktop/Notifications",
            "org.freedesktop.Notifications.CloseNotification",
            str(state["toast"].get("id")),
        )


def dismiss(app: str) -> None:
    path = state_path(app)
    if os.path.exists(path):
        with locked():
            close(path)


class Agent(NamedTuple):
    path: str
    pane: Pane
    event: Event
    since: float
    seen: float | None  # when the user last went to it; None while pending
    notified: bool  # its notification is still up


def agents() -> list[Agent]:
    """The agents on record that have a pane to go to.

    Without its notification, an agent needs a live pane and an event that
    never expires: other records are dropped, as are those whose pane died
    without a dismiss or belonged to an earlier tmux server on the same
    socket. Call it locked.
    """
    found, dropped = [], False
    for path in record_paths():
        state = read_state(path) or {}
        notified = toast_up(state)
        pane = find_pane(state.get("socket"), state.get("pane"))
        event = EVENTS.get(str(state.get("event")))
        since, seen = state.get("since"), state.get("seen")
        if (
            pane
            and pane.server == state.get("server")
            and event
            and (notified or not event.expire_ms)
            and isinstance(since, (int, float))
        ):
            seen = seen if isinstance(seen, (int, float)) else None
            found.append(Agent(path, pane, event, since, seen, notified))
        elif not notified:
            dropped = True
            with suppress(OSError):
                os.unlink(path)
    if dropped:
        refresh_bar()
    return found


def waiting() -> list[Agent]:
    """The agents left without a notification, in the order `next` goes.

    The pending ones first, by how long they have waited, then the seen
    ones, starting with the one visited longest ago. Call it locked.
    """
    return sorted(
        (agent for agent in agents() if not agent.notified),
        key=lambda agent: (agent.seen is not None, agent.seen or agent.since),
    )


def waiting_now() -> list[Agent]:
    if not record_paths():
        return []  # the usual case; waybar asks every 30 s
    with locked():
        return waiting()


def focus_next() -> str | None:
    """Focuses the first waiting agent, which is seen from then on.

    Returns its title, or None if no agent is waiting.
    """
    if not record_paths():
        return None
    with locked():
        found = waiting()
        if not found:
            return None
        agent = found[0]
        if not focus_pane(agent.pane):
            sys.exit("notifi: no Hyprland to focus a window in")
        state = read_state(agent.path) or {}
        # A notify-send left behind by a daemon that died.
        pid = toast_sender(state)
        if pid is not None:
            with suppress(OSError):
                os.kill(pid, signal.SIGTERM)
        state.pop("toast", None)
        write_state(agent.path, state | {"seen": time.time()})
        refresh_bar()
    return agent.pane.title


def dismiss_focused() -> list[str]:
    """Forgets the agent in the focused window; returns the titles.

    That is the agent in the active pane of the tmux window that the focused
    Hyprland window shows or, if that pane has none, every agent in that
    tmux window.
    """
    if not record_paths():
        return []
    hypr = hyprland()
    if not hypr:
        sys.exit("notifi: no Hyprland to find the focused window in")
    with locked():
        found = agents()
        shown = [
            (client, socket)
            for socket in {agent.pane.socket for agent in found}
            for client in attached_clients(hypr, socket)
            if any(
                w.get("focusHistoryID") == 0
                and (w.get("workspace") or {}).get("id")
                in hypr.visible_workspaces
                for w in client.windows
            )
        ]
        if not shown:
            return []
        # A single-instance Ghostty has every client in one process, so
        # several may match the focused window: take the one used last.
        client, socket = max(shown, key=lambda pair: pair[0].activity)
        active = tmux(
            socket, "display-message", "-p", "-t", client.window_id, "#D"
        )
        here = [
            agent
            for agent in found
            if agent.pane.socket == socket
            and agent.pane.session_id == client.session_id
            and agent.pane.window_id == client.window_id
        ]
        here = [a for a in here if a.pane.id == (active or "").strip()] or here
        for agent in here:
            close(agent.path)
    return [agent.pane.title for agent in here]


def show(app: str, event_name: str, force: bool) -> str:
    """Shows a notification; returns `sent` or why it was not sent."""
    if not desktop_allowed():
        return "blocked"
    event = EVENTS[event_name]
    pane = own_pane()
    path = state_path(app)
    command = [
        "notify-send",
        f"--app-name={app}",
        f"--urgency={event.urgency}",
        f"--expire-time={event.expire_ms}",
        "--print-id",
        "--wait",
    ]
    if pane:
        command.append("--action=focus=Focus")
    command += ["--", pane.title if pane else app, event.body]

    with locked():
        # Whatever the agent was waiting with is stale: it has moved on, or
        # the user is looking at it.
        close(path)
        if event.focus_aware and not force and pane and pane_visible(pane):
            return "visible"

        # notify-send --wait lives exactly as long as the notification. It
        # prints the id at once and the chosen action, if any, at the end.
        try:
            sender = subprocess.Popen(
                command,
                stdin=subprocess.DEVNULL,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                start_new_session=True,
            )
        except OSError as error:
            return f"failed: {error}"
        assert sender.stdout and sender.stderr
        ready, _, _ = select.select([sender.stdout], [], [], 5)
        notification_id = (
            sender.stdout.readline().decode().strip() if ready else ""
        )
        if not notification_id:
            sender.kill()
            reason = sender.stderr.read().decode().strip()
            return f"failed: {reason or 'notify-send printed no id'}"
        state: dict[str, Any] = {
            "event": event_name,
            "since": time.time(),
            "toast": {
                "id": notification_id,
                "owner": daemon_owner(),
                "pid": sender.pid,
                "started": start_time(sender.pid),
            },
        }
        if pane:
            state |= {
                "socket": pane.socket,
                "pane": pane.id,
                "server": pane.server,
            }
        write_state(path, state)

    # The caller (an agent hook) must not wait for the notification, so a
    # detached child stays behind for the action.
    sys.stdout.flush()
    if os.fork():
        return "sent"
    os.setsid()
    null = os.open(os.devnull, os.O_RDWR)
    for stream in (0, 1, 2):
        os.dup2(null, stream)
    try:
        acted = b"focus" in sender.stdout.read().split()
        pane = own_pane()  # as it is now
        if acted and pane:
            focus_pane(pane)
        # The agent is still waiting, so its record stays: seen after the
        # action, pending if the notification was only closed. Not if it was
        # closed with the pane on screen, which takes no going to; nor if
        # the notification expires, because a timeout looks the same as a
        # close from here.
        keep = (
            pane is not None
            and not event.expire_ms
            and (acted or not pane_visible(pane))
        )
        with locked():
            state = read_state(path) or {}
            toast = state.get("toast")
            if isinstance(toast, dict) and toast.get("pid") == sender.pid:
                if keep:
                    del state["toast"]
                    if acted:
                        state["seen"] = time.time()
                    write_state(path, state)
                else:
                    os.unlink(path)
                refresh_bar()
    finally:
        os._exit(0)


class Parser(argparse.ArgumentParser):
    def error(self, message: str):
        # Not argparse's exit status 2, which Claude Code reads from a hook
        # as "block this".
        sys.exit(f"{self.prog}: {message}")


def main() -> None:
    parser = Parser(description="Desktop notifications for coding agents.")
    commands = parser.add_subparsers(dest="command", required=True)
    app = Parser(add_help=False)
    app.add_argument(
        "--app",
        default="agent",
        help="agent name: the notification's app name, and its title and "
        "identity outside tmux",
    )
    show_parser = commands.add_parser(
        "show", parents=[app], help="notify for the agent in this pane"
    )
    show_parser.add_argument("--event", choices=EVENTS, default="finished")
    show_parser.add_argument(
        "--force",
        action="store_true",
        help="send even if the pane is on screen",
    )
    show_parser.add_argument(
        "-v", "--verbose", action="store_true", help="print the outcome"
    )
    dismiss_parser = commands.add_parser(
        "dismiss",
        parents=[app],
        help="forget this pane's agent, closing its notification",
    )
    dismiss_parser.add_argument(
        "--focused",
        action="store_true",
        help="the agent in the focused Hyprland window instead",
    )
    pending_parser = commands.add_parser(
        "pending", help="list the agents waiting without a notification"
    )
    pending_parser.add_argument(
        "--waybar",
        action="store_true",
        help="print the count as a waybar module instead, nothing for none",
    )
    commands.add_parser(
        "next", help="focus the next waiting agent, pending ones first"
    )
    commands.add_parser(
        "status", help="print whether this desktop may be notified"
    )
    args = parser.parse_args()

    if args.command == "status":
        print("allowed" if desktop_allowed() else "blocked")
    elif args.command == "dismiss":
        if args.focused:
            for title in dismiss_focused():
                print(title)
        else:
            dismiss(args.app)
    elif args.command == "pending":
        found = waiting_now()
        unseen = sum(agent.seen is None for agent in found)
        if not args.waybar:
            for agent in found:
                state = "pending" if agent.seen is None else "seen"
                print(f"{agent.pane.title}\t{agent.event.body}\t{state}")
        elif found:
            # The pending agents; only once all were gone to, the seen ones.
            bar = {
                "text": str(unseen or len(found)),
                "class": "pending" if unseen else "seen",
            }
            print(json.dumps(bar))
    elif args.command == "next":
        title = focus_next()
        if title:
            print(title)
    else:
        outcome = show(args.app, args.event, args.force)
        if args.verbose:
            print(outcome)
        if outcome.startswith("failed"):
            sys.exit(f"notifi: notify-send {outcome}")


if __name__ == "__main__":
    main()
