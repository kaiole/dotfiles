#!/usr/bin/env zsh
# Install command symlinks without replacing regular files or unrelated links.
emulate -L zsh
setopt err_exit

root="${0:A:h}"
bin="${HOME}/.local/bin"
mkdir -p -- "$bin"
entries=(clang/cfmt clang/tidy scratch/scratch tmux-sessionizer/tmux-sessionizer theme/theme)
if [[ $OSTYPE == linux* ]]; then entries+=(tmux-orphans/tmux-orphans); fi

# notifi and wall_select are Rust binaries for Hyprland; build them in place,
# each from its own directory, where cargo finds notifi's .cargo/config.toml.
if [[ $OSTYPE == linux* ]]; then
  if (( $+commands[cargo] )); then
    for crate in notifi wall_select; do
      (cd -- "$root/$crate" && cargo build --release --locked)
      entries+=($crate/target/release/$crate)
    done
  else
    print -u2 -- "install: cargo not found, skipping notifi and wall_select"
  fi
fi

# Validate all destinations before changing any links.
for entry in "${entries[@]}"; do
  target="$root/$entry"
  link="$bin/${entry:t}"
  if [[ -e "$link" || -L "$link" ]]; then
    if [[ ! -L "$link" || "${link:A}" != "$target" ]]; then
      print -u2 -- "install: refusing to replace $link"
      exit 1
    fi
  fi
done

for entry in "${entries[@]}"; do
  link="$bin/${entry:t}"
  [[ -L "$link" ]] || ln -s -- "$root/$entry" "$link"
  print -- "$link -> $root/$entry"
done

# Render theme templates (generated files are gitignored).
"$root/theme/theme"
