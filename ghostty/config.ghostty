config-file = ?~/dotfiles/ghostty/arch.ghostty
config-file = ?~/dotfiles/ghostty/mac.ghostty

font-family = CaskaydiaCove Nerd Font Mono

theme = palette

font-thicken = false
font-feature = -calt

# Same opacity as the lock screen veil (hypr/hyprlock.conf).
background-opacity = 0.6
background-blur = false

cursor-style = block
cursor-style-blink = true

confirm-close-surface = false

# Claude Code in tmux sends each copy twice (passthrough + tmux's own
# OSC 52 forward), so the copy toast fired twice.
app-notifications = no-clipboard-copy

shell-integration = zsh

shell-integration-features = cursor, no-sudo, no-title

keybind = ctrl+enter=unbind
keybind = ctrl+shift+o=unbind

command = zsh --login -c "if command -v tmux >/dev/null 2>&1; then if tmux ls >/dev/null 2>&1; then tmux attach; else $HOME/.local/bin/tmux-sessionizer $HOME; fi; else zsh; fi"
