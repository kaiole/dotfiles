// -*- mode: jsonc -*-
{
    "position": "top",
    "height": 42,
    "spacing": 3,
    "margin-bottom": 1,
    "modules-left": [
        "custom/spotify",
        "custom/cava_mviz",
        "custom/tibi",
    ],
    "modules-center": [
        "hyprland/submap#left",
        "hyprland/workspaces",
        "hyprland/submap#right"
    ],
    "modules-right": [
        "custom/agents",
        "tray",
        "battery",
        "pulseaudio",
        "backlight",
        "cpu",
        "memory",
        "clock"
    ],
    // Modules configuration
    // "artist - title", at most 17 characters wide (max-length; waybar_media's
    // second argument must match). waybar_media ends the title with "...",
    // which also parts it from the visualizer. A still title is only as wide
    // as it is; a longer one scrolls through the 14 cells before the "..."
    // while it plays, at the full width. Hidden when Spotify is closed.
    "custom/spotify": {
      "tooltip": false,
      "exec": "$HOME/.local/bin/waybar_media spotify 17",
      "format": "{}",
      "max-length": 17,
      "align": 0,
      "return-type": "json",
      "escape": true,
      "on-click": "playerctl --player=spotify previous",
      "on-click-right": "playerctl --player=spotify next",
      "on-click-middle": "playerctl --player=spotify play-pause",
      "on-scroll-up": "playerctl --player=spotify volume 0.05+",
      "on-scroll-down": "playerctl --player=spotify volume 0.05-"
    },
    "custom/cava_mviz": {
      "exec": "$HOME/.local/bin/waybar_cava",
      "restart-interval": 2,
      "tooltip": false,
      "format": "{}"
    },
    // The running tibi session: "󰔛 name 00:23". Hidden when nothing is
    // tracked; class "paused" (dimmed) after `tb pause`. tb escapes the
    // Pango markup itself. Click pauses or resumes. tb's on_change hook
    // (~/.config/tibi/config.toml) sends signal 9 after every change, so the
    // module updates at once; the interval only ticks the minutes. It is 1s,
    // like tmux's status-interval, so both bars turn the minute within a
    // second of each other (tb status takes ~3ms).
    "custom/tibi": {
      "exec": "$HOME/.cargo/bin/tb status --format waybar",
      "return-type": "json",
      "format": "{}",
      "signal": 9,
      "interval": 1,
      "on-click": "$HOME/.cargo/bin/tb pause || $HOME/.cargo/bin/tb resume"
    },
    // Agents that stopped and wait for an answer: how many are pending
    // (notification closed with Super+N) or, when none is, how many are
    // seen (gone to with Super+Y, or stopped on screen; class "seen",
    // dimmed). Super+X forgets the focused one. Hidden at zero. notifi sends signal 8 when the count changes
    // (WAYBAR_SIGNAL in scripts/notifi/src/state.rs); the interval only
    // catches panes that died without telling it.
    "custom/agents": {
      "tooltip": false,
      "exec": "$HOME/.local/bin/notifi pending --waybar",
      "return-type": "json",
      "format": "󰂚 {}",
      "signal": 8,
      "interval": 30,
      "on-click": "$HOME/.local/bin/notifi next"
    },
    "hyprland/submap#left": {
        "format": "⸸",
        "tooltip": false
    },
    "hyprland/submap#right": {
        "format": "⸸",
        "tooltip": false
    },
    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "warp-on-scroll": false,
        "on-click": "activate",
        // Blank label: style.css draws each workspace as a colored box
        "format": "",
        "persistent-workspaces": {
            "1": [],
            "2": [],
            "3": [],
            "4": [],
            "5": []
        }
    },
    "battery": {
      "interval": 60,
      "states": {
        "warning": 30,
        "critical": 15
      },
      "format": "{icon} {capacity}%",
      "format-icons": ["", "", "", "", ""],
      "max-length": 25
    },
    "backlight": {
      "tooltip": false,
      "device": "intel_backlight",
      "min-brightness": 1,
      "format": "{icon} {percent}%",
      "format-icons": ["", ""]
    },
    "cpu": {
      "tooltip": false,
      "interval": 10,
      "format": "{usage}%",
      "max-length": 10
    },
    "memory": {
      "tooltip": false,
      "interval": 30,
      "format": "{avail:0.1f}G"
    },
    "clock": {
        "tooltip": false,
        "interval": 1,
        "format": "{:%m/%d %I:%M}",
    },
    "pulseaudio": {
        "tooltip": false,
        "scroll-step": 2,
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 Muted",           // Icon for mute (you can also use "" or "")
        "format-icons": {
            "default": [ "󰕿", "󰖀", "󰕾", "󰕾" ] // low, med, high, very high
        },
        "on-click": "pamixer --toggle-mute",
        "on-click-right": "pavucontrol"
    },
},

