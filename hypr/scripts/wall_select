#!/usr/bin/env bash
# wall_select: pick a wallpaper from a rofi thumbnail strip and show it on
# the focused monitor with awww. Pressing the bind again closes the picker.
#
# Each wallpaper <name> gets a thumbnail <cache>/<name>.jpg stamped with the
# wallpaper's mtime; differing mtimes mean the thumbnail is stale. Writes are
# atomic, so concurrent runs need no locks.
#
# Based on WallSelect by gh0stzk (GPL-3.0).
# Deps: hyprland, jq, rofi, libvips, awww

set -u
shopt -s nullglob nocaseglob

walls=${WALLPAPER_DIR:-$HOME/images/wallpapers}
cache=${XDG_CACHE_HOME:-$HOME/.cache}/wall_select
theme=$HOME/.config/rofi/applets/wall_select.rasi
thumb_px=512

# Listview geometry from wall_select.rasi, used to fit icons to columns.
cols=6 gap=30 pad=30 elem_pad=3

# A second press closes the picker; rofi -replace below closes any other
# rofi. The pidfile outlives rofi, so confirm the pid is still the picker.
# (pgrep would do, but costs ~40ms scanning /proc.)
pid=
read -r pid 2>/dev/null <"$XDG_RUNTIME_DIR/rofi.pid"
if [[ $pid =~ ^[0-9]+$ ]] &&
	mapfile -d '' argv 2>/dev/null </proc/"$pid"/cmdline &&
	[[ ${argv[*]} == *wall_select.rasi* ]]; then
	kill "$pid"
	exit
fi

files=("$walls"/*.{jpg,jpeg,png,webp,gif,bmp})
if (( ! ${#files[@]} )); then
	notify-send -a wall_select "No wallpapers in $walls"
	exit 1
fi
mapfile -d '' files < <(printf '%s\0' "${files[@]}" | sort -zV)

# Logical width of the focused monitor, accounting for rotation.
read -r mon width hz < <(hyprctl -j monitors | jq -r '.[] | select(.focused)
	| "\(.name) \((if .transform % 2 == 1 then .height else .width end)
	/ .scale | floor) \(.refreshRate | round)"')
icon=$(( (width - 2 * pad - (cols - 1) * gap) / cols - 2 * elem_pad ))

daemon_up=0 current=
if query=$(awww query 2>/dev/null); then
	daemon_up=1
	while IFS= read -r line; do
		[[ $line =~ ^[^:]*:\ ?"$mon":.*\ image:\ (.+)$ ]] &&
			current=${BASH_REMATCH[1]}
	done <<<"$query"
fi

thumbnail() {
	local tmp=$2.$BASHPID.jpg
	if vipsthumbnail "$1" --size "${thumb_px}x$thumb_px" --crop \
		-o "$tmp[Q=90,keep=none]" && touch -r "$1" "$tmp"; then
		mv -f "$tmp" "$2"
	else
		rm -f "$tmp"
	fi
}

selected=0 stale=()
for i in "${!files[@]}"; do
	src=${files[i]} thumb=$cache/${files[i]##*/}.jpg
	[[ $src == "$current" ]] && selected=$i
	[[ -f $thumb && ! $thumb -nt $src && ! $src -nt $thumb ]] ||
		stale+=("$src")
done

# One single-threaded vips job per core beats one multi-threaded job, since
# small images spend most of their time in decode and process startup.
if (( ${#stale[@]} )); then
	export VIPS_CONCURRENCY=1
	mkdir -p "$cache"
	max_jobs=$(nproc) running=0
	for src in "${stale[@]}"; do
		(( running++ >= max_jobs )) && wait -n
		thumbnail "$src" "$cache/${src##*/}.jpg" &
	done
	wait
fi

# Drop thumbnails of deleted wallpapers, and temp files of killed runs.
for thumb in "$cache"/*; do
	src=${thumb##*/}
	[[ -f $walls/${src%.jpg} ]] || rm -f -- "$thumb"
done

# Read every entry before the first frame (-no-custom and -selected-row
# imply -sync too). Async input costs an extra 66ms reload before icons.
choice=$(
	for src in "${files[@]}"; do
		name=${src##*/}
		printf '%s\0icon\x1f%s\n' "${name%.*}" "$cache/$name.jpg"
	done | rofi -dmenu -sync -replace -i -no-custom -format i \
		-selected-row "$selected" \
		-theme "$theme" -theme-str "element-icon { size: ${icon}px; }"
)
[[ $choice =~ ^[0-9]+$ ]] || exit 0

# Autostart launches the daemon; restart it if it has died since.
if (( ! daemon_up )); then
	awww-daemon &>/dev/null & disown
	for _ in {1..20}; do awww query &>/dev/null && break; sleep 0.1; done
fi

awww img -o "$mon" "${files[choice]}" \
	--transition-type wipe --transition-angle 180 \
	--transition-duration 2 --transition-fps "$hz"
