{
  "manifest_version": 3,
  "name": "Palette",
  "version": "1.0",
  "description": "Generated by ~/dotfiles/theme/build.lua from theme/templates/helium/theme/manifest.json -- edit that instead.",
  "theme": {
    "colors": {
      "frame": [{{surface:list}}],
      "frame_inactive": [{{surface:list}}],
      "background_tab": [{{surface:list}}],
      "background_tab_inactive": [{{surface:list}}],
      "tab_background_text": [{{fg_dim:list}}],
      "tab_background_text_inactive": [{{fg_faint:list}}],
      "toolbar": [{{panel:list}}],
      "tab_text": [{{fg_strong:list}}],
      "toolbar_text": [{{fg:list}}],
      "toolbar_button_icon": [{{fg_muted:list}}],
      "bookmark_text": [{{fg:list}}],
      "omnibox_background": [{{statusbar:list}}],
      "omnibox_text": [{{fg_strong:list}}],
      "ntp_background": [{{panel:list}}],
      "ntp_text": [{{fg:list}}],
      "ntp_link": [{{accent_muted:list}}]
    }
  }
}
