{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
    	"source": "~/dotfiles/fastfetch/logos/dismantle.jpg",
    	"type": "kitty-icat",
    	"height": 12,
    	"width": 20,
    },
    "display": {
        "separator": " "
    },
    "modules": [
	"break",
	"break",
        {
            "type": "title",
            "format": "\u001b[38;2;{{fg:rgb}}m{user-name}\u001b[0m\u001b[38;2;{{fg_dim:rgb}}m@\u001b[0m\u001b[38;2;{{fg:rgb}}m{host-name}\u001b[0m"
        },
        {
            "type": "os",
            "key": " ",
            "keyColor": "38;2;{{fg_muted:rgb}}"
        },
        {
            "type": "packages",
            "format": "{} (pacman)",
            "key": " ",
            "keyColor": "38;2;{{fg_muted:rgb}}"
        },
        {
            "type": "wm",
            "key": " ",
            "keyColor": "38;2;{{fg_muted:rgb}}"
        },
        {
            "type": "host",
            "key": "󰌢 ",
            "keyColor": "38;2;{{fg_muted:rgb}}"
        },
        {
            "type": "cpu",
            "key": " ",
            "keyColor": "38;2;{{fg_muted:rgb}}"
        },
        {
            "type": "memory",
            "key": " ",
            "keyColor": "38;2;{{fg_muted:rgb}}"
        },
        {
            "type": "uptime",
            "key": " ",
            "keyColor": "38;2;{{fg_muted:rgb}}"
        },
        {
            "type": "media",
            "key": "󰝚 ",
            "keyColor": "38;2;{{fg_muted:rgb}}"
        },
        {
            // Lackluster monochrome gradient
            "type": "custom",
            "format": "\u001b[38;2;{{surface:rgb}}m▃▃▃  \u001b[38;2;{{border:rgb}}m▃▃▃  \u001b[38;2;{{fg_faint:rgb}}m▃▃▃  \u001b[38;2;{{fg_dim:rgb}}m▃▃▃  \u001b[38;2;{{fg_muted:rgb}}m▃▃▃  \u001b[38;2;{{fg:rgb}}m▃▃▃  \u001b[38;2;{{fg_strong:rgb}}m▃▃▃  \u001b[38;2;{{fg_bright:rgb}}m▃▃▃\u001b[0m"
        },
        "break",
        "break",
    ]
}
