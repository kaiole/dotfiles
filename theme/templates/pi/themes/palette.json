{
  "$schema": "https://raw.githubusercontent.com/earendil-works/pi-mono/main/packages/coding-agent/src/modes/interactive/theme/theme-schema.json",
  "name": "palette",
  "vars": {
    "errorFg": "{{error}}",
    "gray1": "{{bg_alt}}",
    "gray2": "{{surface}}",
    "gray3": "{{border}}",
    "gray4": "{{fg_faint}}",
    "gray5": "{{fg_dim}}",
    "gray6": "{{fg_muted}}",
    "gray7": "{{fg}}",
    "gray8": "{{fg_strong}}",
    "popupBg": "{{popup}}",
    "green": "{{success}}",
    "errorBg": "{{error_bg}}"
  },
  "colors": {
    "accent": "gray8",
    "border": "gray5",
    "borderAccent": "gray7",
    "borderMuted": "gray3",
    "success": "gray7",
    "error": "errorFg",
    "warning": "gray7",
    "muted": "gray6",
    "dim": "gray4",
    "text": "gray7",
    "thinkingText": "gray6",
    "selectedBg": "gray2",
    "userMessageBg": "gray2",
    "userMessageText": "gray7",
    "customMessageBg": "popupBg",
    "customMessageText": "gray7",
    "customMessageLabel": "gray8",
    "toolPendingBg": "gray1",
    "toolSuccessBg": "gray2",
    "toolErrorBg": "errorBg",
    "toolTitle": "gray7",
    "toolOutput": "gray7",
    "mdHeading": "gray5",
    "mdLink": "gray8",
    "mdLinkUrl": "gray6",
    "mdCode": "gray5",
    "mdCodeBlock": "gray8",
    "mdCodeBlockBorder": "gray4",
    "mdQuote": "gray6",
    "mdQuoteBorder": "gray4",
    "mdHr": "gray4",
    "mdListBullet": "gray8",
    "toolDiffAdded": "green",
    "toolDiffRemoved": "errorFg",
    "toolDiffContext": "gray6",
    "syntaxComment": "{{syntax_comment}}",
    "syntaxKeyword": "{{syntax_keyword}}",
    "syntaxFunction": "{{syntax_function}}",
    "syntaxVariable": "{{syntax_variable}}",
    "syntaxString": "{{syntax_string}}",
    "syntaxNumber": "{{syntax_constant}}",
    "syntaxType": "{{syntax_type}}",
    "syntaxOperator": "{{syntax_punctuation}}",
    "syntaxPunctuation": "{{syntax_punctuation}}",
    "thinkingOff": "gray3",
    "thinkingMinimal": "gray4",
    "thinkingLow": "gray5",
    "thinkingMedium": "gray6",
    "thinkingHigh": "gray7",
    "thinkingXhigh": "gray8",
