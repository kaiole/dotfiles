[init]
	defaultBranch = main
[tag]
	gpgSign = true
[merge]
	conflictStyle = zdiff3
	tool = nvimdiff
[rerere]
	enabled = true
[diff]
	algorithm = histogram
[mergetool]
	keepBackup = false
[mergetool "nvimdiff"]
	layout = LOCAL,MERGED,REMOTE
[filter "claude-settings"]
	# Claude Code writes /model and effort choices into the symlinked
	# settings.json; keep them local (see dotfiles .gitattributes).
	clean = jq -S --indent 2 'del(.model, .modelSettings)'
